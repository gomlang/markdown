package tests;

use ecosystem::markdown as md;
use std::testing;

#[test]
fn exported_ast_rendering_and_captured_visitors() -> () {
    let document = testing::expect_ok(
        md::parse("# Heading\n\nSee [GoML][lang].\n\n[lang]: https://example.test/\n"),
        "parse",
    );
    let titles: Vec[string] = Vec::new();
    let prefix = "title: ";
    testing::assert_ok(
        md::walk(
            document,
            |block| {
                if let md::BlockKind::Heading(_, children) = block.kind {
                    titles.push(prefix + testing::expect_ok(md::inline_text(children), "text"));
                }
            },
            |_| (),
        ),
    );
    testing::assert(titles == Vec::from_array(["title: Heading"]));
    testing::assert_eq(
        testing::expect_ok(md::render(document, md::RenderOptions::standard()), "render"),
        "<h1>Heading</h1>\n<p>See <a href=\"https://example.test/\">GoML</a>.</p>\n",
    );
    let custom = md::Document {
        blocks: Vec::from_array(
            [
                md::Block {
                    kind: md::BlockKind::Heading(
                        2,
                        Vec::from_array([md::Inline::Text("Custom & safe")]),
                    ),
                    span: md::LineSpan { start: 0, end: 0 },
                },
            ],
        ),
        references: HashMap::new(),
    };
    testing::assert_eq(
        testing::expect_ok(md::render(custom, md::RenderOptions::standard()), "manual AST"),
        "<h2>Custom &amp; safe</h2>\n",
    );
}

#[test]
fn downstream_render_expansion_obeys_remaining_budget() -> () {
    let doc = testing::expect_ok(md::parse("[界](/界?q=a&b=1)"), "parse");
    let expected = "<p><a href=\"/%E7%95%8C?q=a&amp;b=1\">界</a></p>\n";
    testing::assert_eq(
        testing::expect_ok(
            md::render(
                doc,
                md::RenderOptions {
                    max_bytes: expected.byte_len(),
                    ..md::RenderOptions::standard(),
                },
            ),
            "render",
        ),
        expected,
    );
    testing::assert_err(
        md::render(
            doc,
            md::RenderOptions {
                max_bytes: expected.byte_len() - 1,
                ..md::RenderOptions::standard(),
            },
        ),
    );
}
