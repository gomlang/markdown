package tests;

use ecosystem::markdown;
use std::testing;

#[test]
fn downstream_html_blocks_keep_following_paragraphs_outside_quotes() -> () {
    let document = testing::expect_ok(markdown::parse("> <div>\n> \tinside\noutside\n"), "parse");
    testing::assert_eq(
        testing::expect_ok(
            markdown::render(document, markdown::RenderOptions::commonmark()),
            "render",
        ),
        "<blockquote>\n<div>\n\tinside\n</blockquote>\n<p>outside</p>\n",
    );
    let document = testing::expect_ok(
        markdown::parse_gfm("> <div>\n> a | b\n> - | -\noutside\n"),
        "GFM parse",
    );
    testing::assert_eq(
        testing::expect_ok(
            markdown::render_gfm(document, markdown::RenderOptions::commonmark()),
            "GFM render",
        ),
        "<blockquote>\n<div>\na | b\n- | -\n</blockquote>\n<p>outside</p>\n",
    );
}
