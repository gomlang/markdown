package markdown;

use std::text;

enum Visit {
    Blocks(Vec[Block], isize),
    Inlines(Vec[Inline], isize),
    Items(Vec[Vec[Block]], isize),
}

fn walk_stack(stack: Vec[(Visit, isize)], visit_block: (Block) -> (), visit_inline: (Inline) -> ()) -> Result[
    (),
    Error,
] {
    let mut count = 0;
    let mut items_seen = 0;
    while let Some((visit, depth)) = stack.pop() {
        match visit {
            Visit::Blocks(values, index) => {
                if index == values.len() {
                    continue
                }
                count += 1;
                if count > 250000 || depth > 256 {
                    return Result::Err(Error { line: 0, message: "AST walk limit exceeded" })
                }
                if index + 1 < values.len() {
                    stack.push((Visit::Blocks(values, index + 1), depth));
                }
                let block = values[index];
                visit_block(block);
                match block.kind {
                    BlockKind::Paragraph(values) | BlockKind::Heading(_, values) => stack.push(
                        (Visit::Inlines(values, 0), depth + 1),
                    ),
                    BlockKind::Quote(values) => stack.push((Visit::Blocks(values, 0), depth + 1)),
                    BlockKind::List(_, _, _, items) => stack.push(
                        (Visit::Items(items, 0), depth + 1),
                    ),
                    _ => (),
                }
            },
            Visit::Inlines(values, index) => {
                if index == values.len() {
                    continue
                }
                count += 1;
                if count > 250000 || depth > 256 {
                    return Result::Err(Error { line: 0, message: "AST walk limit exceeded" })
                }
                if index + 1 < values.len() {
                    stack.push((Visit::Inlines(values, index + 1), depth));
                }
                let inline = values[index];
                visit_inline(inline);
                match inline {
                    Inline::Emphasis(values) | Inline::Strong(values) | Inline::Link(_, _, values) | Inline::Image(_, _, values) => stack.push(
                        (Visit::Inlines(values, 0), depth + 1),
                    ),
                    _ => (),
                }
            },
            Visit::Items(items, index) => {
                if index == items.len() {
                    continue
                }
                items_seen += 1;
                if items_seen > 250000 {
                    return Result::Err(
                        Error { line: 0, message: "AST list item walk limit exceeded" },
                    )
                }
                if index + 1 < items.len() {
                    stack.push((Visit::Items(items, index + 1), depth));
                }
                stack.push((Visit::Blocks(items[index], 0), depth));
            },
        }
    }
    Result::Ok(())
}

pub fn walk(document: Document, visit_block: (Block) -> (), visit_inline: (Inline) -> ()) -> Result[
    (),
    Error,
] {
    let stack: Vec[(Visit, isize)] = Vec::new();
    stack.push((Visit::Blocks(document.blocks, 0), 0));
    walk_stack(stack, visit_block, visit_inline)
}

pub fn inline_text(inlines: Vec[Inline]) -> Result[string, Error] {
    let output = text::StringBuilder::new();
    let stack: Vec[(Visit, isize)] = Vec::new();
    stack.push((Visit::Inlines(inlines, 0), 0));
    walk_stack(
        stack,
        |_| (),
        |inline| {
            match inline {
                Inline::Text(value) => output.write_string(value),
                Inline::Code(value) => output.write_string(value),
                Inline::SoftBreak => output.write_char('\n'),
                Inline::HardBreak => output.write_char('\n'),
                _ => (),
            }
        },
    )?;
    Result::Ok(output.finish())
}
