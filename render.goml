package markdown;

use std::text;
use ecosystem::html;

pub fn escape_html(value: string) -> string {
    html::escape_text(value)
}

pub fn safe_url(value: string) -> bool {
    let mut scheme = "";
    let mut too_long = false;
    for ch in value.chars() {
        if ch <= ' ' || whitespace(ch) {
            continue
        }
        if ch == ':' {
            let lower = scheme.to_ascii_lowercase();
            return !too_long
                && (lower == "http" || lower == "https" || lower == "mailto" || lower == "ftp")
        }
        if !ascii_letter(ch) && !ascii_digit(ch) && !"+.-".contains(ch.to_string()) {
            return true
        }
        if scheme.byte_len() < 6 {
            scheme += ch.to_string();
        } else {
            too_long = true;
        }
    }
    true
}

struct Renderer {
    options: RenderOptions,
    output: text::StringBuilder,
}

impl Renderer {
    fn write(self: Renderer, value: string) -> Result[(), Error] {
        if value.byte_len() > self.options.max_bytes - self.output.len() {
            return Result::Err(Error { line: 0, message: "rendered output exceeds size limit" })
        }
        self.output.write_string(value);
        Result::Ok(())
    }

    fn escaped(self: Renderer, value: string) -> Result[(), Error] {
        let escaped = html::escape_with(
            value,
            html::EscapeOptions::text(),
            self.options.max_bytes - self.output.len(),
        ).map_err(|_| Error { line: 0, message: "rendered output exceeds size limit" })?;
        self.write(escaped)
    }

    fn url(self: Renderer, value: string) -> Result[(), Error] {
        let hex = "0123456789ABCDEF";
        let allowed = "-._~:/?#@!$&'()*+,;=%".to_bytes();
        let mut start = 0;
        for index in 0..value.byte_len() {
            let byte = value.byte_get(index);
            if (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
                || (byte >= 48 && byte <= 57)
                || allowed.contains(byte) {
                continue
            }
            if start < index {
                self.escaped(value.byte_slice(start, index))?;
            }
            self.write("%")?;
            self.write(hex.byte_slice((byte / 16).to_isize(), (byte / 16).to_isize() + 1))?;
            self.write(hex.byte_slice((byte % 16).to_isize(), (byte % 16).to_isize() + 1))?;
            start = index + 1;
        }
        self.escaped(value.byte_slice(start, value.byte_len()))
    }

    fn depth(self: Renderer, depth: isize) -> Result[(), Error] {
        if depth > self.options.max_depth {
            Result::Err(Error { line: 0, message: "render nesting limit exceeded" })
        } else {
            Result::Ok(())
        }
    }

    fn inlines(self: Renderer, values: Vec[Inline], depth: isize, plain: bool) -> Result[(), Error] {
        self.depth(depth)?;
        for value in values {
            match value {
                Inline::Text(text) => self.escaped(text)?,
                Inline::Code(text) => {
                    if !plain {
                        self.write("<code>")?;
                    }
                    self.escaped(text)?;
                    if !plain {
                        self.write("</code>")?;
                    }
                },
                Inline::Html(text) => if !plain {
                    if self.options.allow_raw_html {
                        self.write(text)?;
                    } else {
                        self.escaped(text)?;
                    }
                },
                Inline::SoftBreak => self.write(
                    if plain || !self.options.hard_breaks {
                        "\n"
                    } else if self.options.xhtml {
                        "<br />\n"
                    } else {
                        "<br>\n"
                    },
                )?,
                Inline::HardBreak => self.write(
                    if plain {
                        "\n"
                    } else if self.options.xhtml {
                        "<br />\n"
                    } else {
                        "<br>\n"
                    },
                )?,
                Inline::Emphasis(children) => {
                    if !plain {
                        self.write("<em>")?;
                    }
                    self.inlines(children, depth + 1, plain)?;
                    if !plain {
                        self.write("</em>")?;
                    }
                },
                Inline::Strong(children) => {
                    if !plain {
                        self.write("<strong>")?;
                    }
                    self.inlines(children, depth + 1, plain)?;
                    if !plain {
                        self.write("</strong>")?;
                    }
                },
                Inline::Link(destination, title, children) => {
                    if !plain {
                        let url = if self.options.allow_unsafe_urls || safe_url(destination) {
                            destination
                        } else {
                            ""
                        };
                        self.write("<a href=\"")?;
                        self.url(url)?;
                        self.write("\"")?;
                        if title != "" {
                            self.write(" title=\"")?;
                            self.escaped(title)?;
                            self.write("\"")?;
                        }
                        self.write(">")?;
                    }
                    self.inlines(children, depth + 1, plain)?;
                    if !plain {
                        self.write("</a>")?;
                    }
                },
                Inline::Image(destination, title, children) => {
                    if !plain {
                        let url = if self.options.allow_unsafe_urls || safe_url(destination) {
                            destination
                        } else {
                            ""
                        };
                        self.write("<img src=\"")?;
                        self.url(url)?;
                        self.write("\" alt=\"")?;
                    }
                    self.inlines(children, depth + 1, true)?;
                    if !plain {
                        self.write("\"")?;
                        if title != "" {
                            self.write(" title=\"")?;
                            self.escaped(title)?;
                            self.write("\"")?;
                        }
                        self.write(
                            if self.options.xhtml {
                                " />"
                            } else {
                                ">"
                            },
                        )?;
                    }
                },
            }
        }
        Result::Ok(())
    }

    fn blocks(self: Renderer, blocks: Vec[Block], depth: isize, tight: bool) -> Result[(), Error] {
        self.depth(depth)?;
        for index in 0..blocks.len() {
            let block = blocks[index];
            match block.kind {
                BlockKind::Paragraph(children) => {
                    if !tight {
                        self.write("<p>")?;
                    }
                    self.inlines(children, depth + 1, false)?;
                    if !tight {
                        self.write("</p>\n")?;
                    } else if index + 1 < blocks.len() {
                        self.write("\n")?;
                    }
                },
                BlockKind::Heading(level, children) => {
                    if level < 1 || level > 6 {
                        return Result::Err(
                            Error {
                                line: block.span.start,
                                message: "heading level must be 1 through 6",
                            },
                        )
                    }
                    self.write(f"<h{level}>")?;
                    self.inlines(children, depth + 1, false)?;
                    self.write(f"</h{level}>\n")?;
                },
                BlockKind::Code(info, literal) => {
                    self.write("<pre><code")?;
                    let mut end = 0;
                    while end < info.byte_len() && info.byte_get(end) != b' '
                        && info.byte_get(end) != b'\t' {
                        end += 1;
                    }
                    let language = info.byte_slice(0, end);
                    if language != "" {
                        self.write(" class=\"language-")?;
                        self.escaped(language)?;
                        self.write("\"")?;
                    }
                    self.write(">")?;
                    self.escaped(literal)?;
                    self.write("</code></pre>\n")?;
                },
                BlockKind::Html(literal) => if self.options.allow_raw_html {
                    self.write(literal)?;
                } else {
                    self.escaped(literal)?;
                },
                BlockKind::ThematicBreak => self.write(
                    if self.options.xhtml {
                        "<hr />\n"
                    } else {
                        "<hr>\n"
                    },
                )?,
                BlockKind::Quote(children) => {
                    self.write("<blockquote>\n")?;
                    self.blocks(children, depth + 1, false)?;
                    self.write("</blockquote>\n")?;
                },
                BlockKind::List(ordered, start, compact, items) => {
                    let tag = if ordered {
                        "ol"
                    } else {
                        "ul"
                    };
                    self.write("<" + tag)?;
                    if ordered && start != 1 {
                        self.write(f" start=\"{start}\"")?;
                    }
                    self.write(">\n")?;
                    for item in items {
                        self.write("<li>")?;
                        if !item.is_empty() {
                            let inline_first = match item[0].kind {
                                BlockKind::Paragraph(_) => compact,
                                _ => false,
                            };
                            if !inline_first {
                                self.write("\n")?;
                            }
                            self.blocks(item, depth + 1, compact)?;
                        }
                        self.write("</li>\n")?;
                    }
                    self.write("</" + tag + ">\n")?;
                },
            }
        }
        Result::Ok(())
    }
}

pub fn render(document: Document, options: RenderOptions) -> Result[string, Error] {
    if options.max_depth < 0 || options.max_bytes < 0 {
        return Result::Err(Error { line: 0, message: "invalid render limits" })
    }
    let renderer = Renderer { options, output: text::StringBuilder::new() };
    renderer.blocks(document.blocks, 0, false)?;
    Result::Ok(renderer.output.finish())
}

pub fn to_html(source: string) -> Result[string, Error] {
    render(parse(source)?, RenderOptions::standard())
}
